{
  "name": "claude-of-duty",
  "version": "1.2.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "imports": {
    "#worldgen/*": "./tools/worldgen/*.ts",
    "#query-snapshot": "./src/physics/query-snapshot.ts"
  },
  "scripts": {
    "assets": "bun tools/build-assets.ts",
    "models": "bun tools/export-models.ts",
    "models:cook": "bun build/models.ts",
    "world": "bun tools/export-world.ts",
    "world:validate": "bun tools/validate-world-assets.ts",
    "world:smoke": "bun tests/e2e/world-smoke.ts",
    "test": "bun tools/export-world.ts && bun tools/test.ts",
    "typecheck": "bun check && bun check -p tools && bun check -p build && bun check -p tests",
    "format": "bun fmt src build tools tests docs README.md ARCHITECTURE.md prompt.md index.html tsconfig.json .oxlintrc.json .oxfmtrc.json package.json",
    "format:check": "bun run format --check",
    "lint": "bun --bun run oxlint --type-aware src build tools tests --deny-warnings",
    "dev": "bun build/bun.ts dev",
    "prebuild": "bun run typecheck && bun run lint",
    "build": "bun build/bun.ts build",
    "build:ci": "OW_SKIP_ASSETS=1 bun run build",
    "build:sourcemap": "OW_SOURCEMAP=1 bun build/bun.ts build",
    "preview": "bun build/bun.ts preview",
    "shot": "bun tools/capture.ts"
  },
  "dependencies": {
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/wasm": "0.43.1",
    "pixi.js": "8.22.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@recast-navigation/generators": "0.43.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.187.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0"
  },
  "packageManager": "bun@1.4.4"
}
