{
  "name": "claude-of-duty",
  "version": "1.0.0",
  "scripts": {
    "assets": "npm run models && npm run world:validate",
    "models": "node tools/export-models.mjs",
    "world": "npm run world:export",
    "world:export": "node tools/export-world-blender.mjs && node tools/validate-world-assets.mjs",
    "world:check": "node tools/export-world-blender.mjs --check && node tools/validate-world-assets.mjs",
    "world:validate": "node tools/validate-world-assets.mjs",
    "world:organize": "blender --background assets/world/world.blend --python tools/blender/organize-world-source.py",
    "world:source:validate": "blender --background assets/world/world.blend --python tools/blender/validate-world-source.py --",
    "world:smoke": "node tools/world-smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:sourcemap": "OW_SOURCEMAP=1 vite build",
    "preview": "vite preview --port 4173",
    "shot": "node tools/capture.mjs"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "vite": "^8.1.5"
  },
  "private": true
}
