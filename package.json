{
  "name": "claude-of-duty",
  "version": "1.1.1",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "assets": "node tools/build-assets.mjs",
    "models": "node tools/export-models.mjs",
    "models:cook": "node build/models.mjs",
    "world": "node tools/export-world.mjs",
    "world:validate": "node tools/validate-world-assets.mjs",
    "world:smoke": "node tests/e2e/world-smoke.ts",
    "test": "node --test tests/smoke/smoke.test.ts",
    "typecheck": "bun check",
    "format": "bun fmt src build tools tests docs README.md ARCHITECTURE.md prompt.md index.html vite.config.js tsconfig.json .oxlintrc.json .oxfmtrc.json package.json",
    "format:check": "bun run format --check",
    "lint": "oxlint src build tools tests --deny-warnings && oxlint --type-aware src tests tools/lib tools/nav240 --ignore-pattern '**/*.js' --ignore-pattern '**/*.mjs' --deny-warnings",
    "dev": "vite",
    "prebuild": "bun run typecheck && bun run lint",
    "build": "vite build",
    "build:ci": "OW_SKIP_ASSETS=1 bun run build",
    "build:sourcemap": "OW_SOURCEMAP=1 vite build",
    "preview": "vite preview --port 4173",
    "shot": "node tools/capture.mjs"
  },
  "dependencies": {
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/wasm": "0.43.1",
    "pixi.js": "8.22.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@recast-navigation/generators": "0.43.1",
    "@types/three": "0.187.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "bun@1.4.4"
}
