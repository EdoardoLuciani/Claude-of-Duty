# Local secrets; only the placeholder template is committed.
.env
.env.*
!.env.example

node_modules/
__pycache__/
*.py[cod]
*.blend[1-9]

# Build output
dist/
playable-snapshot/
perf-candidate/
perf-cand2/

# Capture output — 780 MB of PNGs (regenerate with tools/capture.mjs).
shots/

# Arm maps are packed in the authoring .blend and runtime GLB; reviews regenerate.
assets/player/arms/*.png
assets/player/arms/review/

# Authored weapon review artifacts; keep source, runtime assets and textures.
assets/weapons/*/renders/
assets/weapons/*/gameplay/

# Agent scratch
demo/
.tmp-demo/
.tmp-rend/
revcrops/

# Generated models; the committed world/proc tiles are the exception.
public/models/*
!public/models/world/
!public/models/world/**
!public/models/proc/
!public/models/proc/**
