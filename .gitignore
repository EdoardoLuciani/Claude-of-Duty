# Local secrets; only the placeholder template is committed.
.env
.env.*
!.env.example

node_modules/
__pycache__/
*.py[cod]
*.blend[1-9]

# Build output
dist/
playable-snapshot/
perf-candidate/
perf-cand2/

# Capture output — 780 MB of PNGs (regenerate with tools/capture.mjs).
shots/

# Arm maps are packed in the authoring .blend and runtime GLB; reviews regenerate.
assets/player/arms/*.png
assets/player/arms/review/

# Authored weapon review artifacts; keep source, runtime assets and textures.
assets/weapons/*/renders/
assets/weapons/*/gameplay/

# Agent scratch
demo/
.tmp-demo/
.tmp-rend/
revcrops/

# Generated models, including the world (tools/build-assets.mjs).
public/models/

# Blender/gltfpack products, rebuilt by `bun run build`/`bun run dev` when their
# inputs change. Weapon manifest.json stays committed: weapon code imports it.
assets/weapons/*/*.blend
assets/weapons/*/*.glb
assets/weapons/*/*.png
assets/weapons/*/textures/
assets/attachments/*/*.blend
assets/attachments/*/*.glb
assets/attachments/*/*.png
assets/attachments/*/manifest.json
assets/player/arms/*.blend
assets/player/arms/manifest.json
assets/soldiers/*.blend
assets/soldiers/*.glb
assets/soldiers/*.json
.cache/
